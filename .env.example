# Example environment variables for Stargate Cafe
# Copy to .env and edit values before running docker-compose or starting locally

STARGATE_SECRET_KEY=replace_this_with_a_long_random_hex_64_chars
FLASK_ENV=production

# Optional overrides
EXCHANGE_RATE=89500.0
PC_PRICE_PER_CLICK_LBP=100000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# If you want the session cookie to be sent only over HTTPS, set below to 1 (recommended in production)
STARGATE_COOKIE_SECURE=1
# Extra upload paths (semicolon-separated) - optional
EXTRA_UPLOAD_PATHS=
