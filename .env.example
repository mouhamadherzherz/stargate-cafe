# ============================================================
# STARGATE CAFE ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and configure secrets before deployment
# ============================================================

# Secret key for session encryption & CSRF tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
STARGATE_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key

# Background update checker (0 = disabled in container, 1 = enabled)
ENABLE_OTA_CHECKS=0

# Application Port (default 5000)
PORT=5000

# Environment mode
FLASK_ENV=production
