# ============================================================
# Environment Variables for Stargate Cafe
# ============================================================
# Copy this file to .env before running:
# cp .env.example .env

# Generate a strong 64-char hex secret key using:
# python -c "import secrets; print(secrets.token_hex(32))"
# or openssl:
# openssl rand -hex 32
STARGATE_SECRET_KEY=replace_this_with_a_long_random_hex_64_chars

FLASK_ENV=production

# 1 = Only send session cookie over HTTPS, 0 = Allow HTTP (useful for local dev/testing)
STARGATE_COOKIE_SECURE=0
STARGATE_COOKIE_SAMESITE=Lax
STARGATE_SESSION_DAYS=7

# Enable/disable periodic background OTA update checks (0 in CI/Docker, 1 in production)
ENABLE_OTA_CHECKS=0

# Currency and pricing overrides
EXCHANGE_RATE=89500.0
PC_PRICE_PER_CLICK_LBP=100000

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Extra legacy upload paths (semicolon-separated) - optional
EXTRA_UPLOAD_PATHS=
